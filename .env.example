# ── LLM ─────────────────────────────────────────────────────────────
# Resolution order: Groq → Gemini → Bedrock.  Set one.
GROQ_API_KEY=""
GEMINI_API_KEY=""

# ── AWS ─────────────────────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_BEDROCK_REGION="us-east-1"
# Optional base credentials for the backend identity used to call STS AssumeRole.
# If omitted, boto3 uses the default credential chain (for example: EC2 instance role).
#DRIFT_BACKEND_AWS_ACCESS_KEY_ID="AKIA..."
#DRIFT_BACKEND_AWS_SECRET_ACCESS_KEY="..."
# Optional Bedrock-specific credentials (only if the Bedrock role/account differs)
#AWS_BEDROCK_ACCESS_KEY_ID="AKIA..."
#AWS_BEDROCK_SECRET_ACCESS_KEY="..."

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_ANON_KEY="eyJ..."

# ── Session auth ────────────────────────────────────────────────────
# Required. HMAC secret for signed session cookies (min 32 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=""

# Public URL users open in the browser (required on EC2 for Supabase email links).
# e.g. http://54.x.x.x:8080 or https://drift.example.com — no trailing slash.
PUBLIC_APP_URL=""

# ── Environment-scoped configuration is stored in the database. ─────
# No global TF_STATE_*, GITHUB_*, AWS_ACCESS_KEY_ID, or notification fallback vars remain.
